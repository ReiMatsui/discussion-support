{"turn_id": "t1", "speaker": "A", "text": "費用をどう賄うか？", "ms": 1000, "end_ms": 2000}
{"turn_id": "t2", "speaker": "B", "text": "費用の負担について話しましょう", "ms": 11000, "end_ms": 12000}
