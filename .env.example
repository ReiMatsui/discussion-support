# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_MODEL_FAST=gpt-5-mini
OPENAI_MODEL_SMART=gpt-5

# Soniox (リアルタイム書き起こし — https://console.soniox.com)
SONIOX_API_KEY=...

# Speechmatics (オプション — --stt speechmatics 使用時)
SPEECHMATICS_API_KEY=...

# Tavily (M3 で使用)
TAVILY_API_KEY=tvly-...

# 動作設定
DAS_LOG_LEVEL=INFO
DAS_DATA_DIR=./data
DAS_LINKING_THRESHOLD=0.6
