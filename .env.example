# OpenAI
OPENAI_API_KEY=sk-...
# 既定は GPT-5.4 系 (2026-03〜)。旧 gpt-5-mini / gpt-5 は2世代前。
# 旧名がここに残っていると新既定が効かないので注意。
OPENAI_MODEL_FAST=gpt-5.4-mini
OPENAI_MODEL_SMART=gpt-5.4-mini

# Soniox (リアルタイム書き起こし — https://console.soniox.com)
SONIOX_API_KEY=...

# Speechmatics (オプション — --stt speechmatics 使用時)
SPEECHMATICS_API_KEY=...

# Tavily (M3 で使用)
TAVILY_API_KEY=tvly-...

# 動作設定
DAS_LOG_LEVEL=INFO
DAS_DATA_DIR=./data
DAS_LINKING_THRESHOLD=0.6
# ライブ音声モデル (省略時 gpt-realtime-2.1。旧: gpt-realtime-2)
# OPENAI_REALTIME_MODEL=gpt-realtime-2.1
